<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Post</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>Edit Post</h1>
    <div class="card">
      <form action="/posts/<%= post.blog_id %>/update" method="POST">
        <div class="form-group">
          <label>Author</label>
          <input type="text" value="<%= post.creator_name %>" disabled>
        </div>
        <div class="form-group">
          <label>Title</label>
          <input type="text" name="title" value="<%= post.title %>" required>
        </div>
        <div class="form-group">
          <label>Content</label>
          <textarea name="content" rows="6" required><%= post.body %></textarea>
        </div>
        <div class="actions">
          <button type="submit" class="btn">Save Changes</button>
          <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</body>
</html>