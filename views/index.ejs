<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Blog</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>Blog Feed</h1>

    <!-- Top Navigation -->
    <div style="margin-bottom: 20px;">
      <% if (user) { %>
        <span>Hello, <b><%= user.name %></b>!</span> | 
        <a href="/signout">Sign Out</a>
      <% } else { %>
        <a href="/signin" class="btn">Sign In</a>
        <a href="/signup" class="btn btn-secondary">Sign Up</a>
      <% } %>
    </div>

    <!-- Create Post Form (Only shows if logged in) -->
    <% if (user) { %>
      <div class="card">
        <h3>Create a Post</h3>
        <form action="/posts" method="POST">
          <div class="form-group">
            <label>Title</label>
            <input type="text" name="title" required placeholder="Title">
          </div>
          <div class="form-group">
            <label>Content</label>
            <textarea name="content" rows="4" required placeholder="Write your post..."></textarea>
          </div>
          <button type="submit" class="btn">Publish</button>
        </form>
      </div>
    <% } %>

    <!-- List of Posts -->
    <h2>Recent Posts</h2>
    <% if (posts.length === 0) { %>
      <p>No posts yet.</p>
    <% } else { %>
      <% posts.forEach(post => { %>
        <article class="post">
          <h3><%= post.title %></h3>
          <div class="post-meta">
            By <%= post.creator_name %> • <%= new Date(post.date_created).toLocaleDateString() %>
          </div>
          <p><%= post.body %></p>
          
          <!-- Only owner can edit/delete -->
          <% if (user && user.user_id === post.creator_user_id) { %>
            <div class="actions">
              <a href="/posts/<%= post.blog_id %>/edit" class="btn btn-secondary">Edit</a>
              <form action="/posts/<%= post.blog_id %>/delete" method="POST">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Delete post?')">Delete</button>
              </form>
            </div>
          <% } %>
        </article>
      <% }); %>
    <% } %>
  </div>
</body>
</html>